# auto: OpenRouter when its key is set, then OpenAI, otherwise local rules.
# Set openrouter explicitly to require a key and surface configuration errors.
AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_MS=30000
HOST=127.0.0.1
PORT=5173
# Relative to codebase/, or an absolute path. Raw data stays outside Git.
DISCORD_PACK_DIR=../discord-pack
